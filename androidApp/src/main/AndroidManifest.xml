<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Runtime-requested on Android 13 and up, and asked for the first time a Slot is hearted
        rather than at launch — see ReminderEffects. Deliberately no SCHEDULE_EXACT_ALARM: the
        reminder fires half an hour ahead, which absorbs the drift of an inexact alarm, and the
        exact variants cost either a trip to a system settings screen or a Play policy review.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Android keeps no record of an alarm across a restart, so without this a Slot hearted on the
        Thursday loses its reminder to a phone restarted on the Friday. Normal permission, granted at
        install; see BootReceiver for what it does with it.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".YadloApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!--
            Portrait only. Every screen in the app is a single scrolling column measured against a
            phone held upright, and nothing here gains a second pane in landscape — a wider Programme
            row is the same row with more empty middle. `portrait` rather than `sensorPortrait`, so
            a phone lying flat on a table cannot flip the app upside down.

            Note this is a request, not a guarantee: from Android 16 the system ignores orientation
            restrictions on displays 600dp and wider, which this app targets. A tablet or an unfolded
            foldable will therefore rotate, and the layouts hold there because they are all one
            column — this stops a phone rotating, which is what it is for.
        -->
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Not exported: the only thing that ever sends to it is an alarm this app scheduled, and
            leaving it open would let any app on the device post a notification in Yadlo's name.
        -->
        <receiver
            android:name="io.nicolaszurbuchen.yadlo.infra.notification.ReminderReceiver"
            android:exported="false" />

        <!--
            Exported, unlike the one above, because the sender is the system and a manifest receiver
            has to be visible to it. Safe to open: BOOT_COMPLETED is a protected broadcast, so no
            other app on the device can send it.
        -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
